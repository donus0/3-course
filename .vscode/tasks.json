{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "cmake: configure (task1)",
      "type": "shell",
      "command": "cmake",
      "args": ["-S", "${workspaceFolder}", "-B", "${workspaceFolder}/build/task1", "-G", "MinGW Makefiles", "-DCMAKE_BUILD_TYPE=Debug"],
      "problemMatcher": []
    },
    {
      "label": "cmake: build (task1)",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "${workspaceFolder}/build/task1", "-j"],
      "dependsOn": "cmake: configure (task1)",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "run: task1",
      "type": "shell",
      "command": "${workspaceFolder}/build/task1/task1/task1.exe",
      "dependsOn": "cmake: build (task1)",
